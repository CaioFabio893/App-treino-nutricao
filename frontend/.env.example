# ──────────────────────────────────────────────────────────────────────────
# FRONTEND — variáveis de ambiente
# Copie este arquivo para `frontend/.env.local` e preencha com seus valores.
# NENHUMA credencial real deve ser commitada. Aqui há apenas placeholders.
# ──────────────────────────────────────────────────────────────────────────

# Modo demonstração: "1" (ou "true"/"demo") ativa dados fictícios em
# localStorage e ignora o Firebase — ideal para testar sem backend.
# Deixe vazio/remova para usar o Firebase de verdade.
NEXT_PUBLIC_DEMO=1

# URL pública da API Go (sem barra final).
# Vazio = mesmo domínio do frontend (proxy/reverse em produção).
NEXT_PUBLIC_API_URL=

# ── Firebase (Web App / configuração pública) ─────────────────────────────
# Crie o projeto em https://console.firebase.google.com e cole os valores da
# seção "Configuração do SDK da Web". São dados públicos do cliente (não é
# segredo), mas NUNCA coloque aqui credenciais de conta de serviço.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ──────────────────────────────────────────────────────────────────────────
# BACKEND (referência para o deploy — NÃO é usado pelo build do frontend)
# ──────────────────────────────────────────────────────────────────────────
# PORT=8080                                    # porta do servidor (Cloud Run injeta)
# ALLOWED_ORIGIN=https://app.exemplo.com.br    # origem permitida no CORS (vazio = todas)
# RATE_LIMIT=60                                # requisições/min por IP (vazio = padrão)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/service-account.json  # credencial Firestore/ADC