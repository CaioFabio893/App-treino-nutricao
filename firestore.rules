// Regras do Firestore.
//
// IMPORTANTE: o app acessa o banco SOMENTE através da API Go (que usa o
// Admin SDK e ignora estas regras). Estas regras bloqueiam qualquer tentativa
// de contornar a API Go conectando o Firestore direto pelo cliente
// (config pública do Firebase Web permite acesso via SDK cliente).
//
// Política de acesso refletida nas regras (espelha o backend):
//   - Papéis: somente 'admin' e 'student'. O modelo é de 2 papéis e não
//     possui nenhum terceiro papel de gestão.
//   - Aprovação e pausa são eixos SEPARADOS e nunca conflatedos:
//       · isApprovedUser() decide APROVAÇÃO (legado "" ou "active") e nunca
//         menciona 'paused' como critério de aprovação.
//       · isPausedUser() expõe a pausa de forma explícita, para que qualquer
//         funcionalidade que queira RESTRINGIR o usuário pausado possa
//         consultar esse helper explicitamente em vez de sequestrar o
//         conceito de "aprovado".
//     Um aluno pausado continua sendo um cadastro aprovado: pausar a
//     assinatura não o transforma em pendente/rejeitado.
//   - "pending_approval", "rejected" e "inactive" (bloqueado) NÃO acessam
//     recursos de negócio. Admin sempre passa (bypass de status).
//   - Perfil do usuário: o próprio dono lê/cria/edita SOMENTE os campos da
//     allowlist (name, email, photoURL, bio); tudo o mais — role, status,
//     planID, features, approvedBy, approvedAt,
//     rejectedReason, createdAt, authProvider, startDate... — muda SOMENTE
//     pela API Go, nunca por SDK de cliente, nem admin (hasOnly nega até
//     combinações "campo legítimo + campo sensível" no mesmo update).
//   - Escrita de dados de negócio (posts, dietLogs, workouts, diets,
//     workoutHistory, plans, scores, scores_history): SOMENTE pela API Go.
//     O cliente (SDK) tem acesso de LEITURA quando autorizado (aprovado +
//     relação dono/admin no caso de dados de aluno).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function meExists() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return meExists() && me().data.role == 'admin';
    }

    // "Cadastro APROVADO", isolado da pausa. pending_approval/rejected/inactive
    // ficam de fora; admin passa por bypass de status.
    //
    // IMPORTANTE: 'paused' NÃO é critério de aprovação e não aparece aqui.
    // Aprovação e pausa são eixos independentes (ver isPausedUser). Quem
    // precisa do comportamento efetivo do backend (aprovado OU pausado) usa
    // canUseBusinessResources(), não este helper.
    function isApprovedUser() {
      return meExists() && (
        me().data.role == 'admin' ||
        me().data.status == '' ||
        me().data.status == 'active'
      );
    }

    // "Cadastro PAUSADO": predicate explícito e isolado. Existindo separado de
    // isApprovedUser, uma funcionalidade que queira excluir o aluno pausado
    // escreve `&& !isPausedUser()` na SUA regra, sem precisar reescrever (nem
    // corromper) a noção de aprovação.
    function isPausedUser() {
      return meExists() && me().data.status == 'paused';
    }

    // Recurso de negócio exige cadastro aprovado OU pausado — as duas condições
    // são disjuntas e checadas separadamente, sem uma tratar a outra como
    // sinônimo. Espelha middleware.IsApproved (que aceita "", active e paused),
    // então nenhuma regra aqui diverge da API Go.
    function canUseBusinessResources() {
      return isApprovedUser() || isPausedUser();
    }

    // Dados de um aluno: o próprio dono ou o admin. Como o modelo é de 2 papéis,
    // a relação se resume a self/admin — a mesma matriz de
    // service.CanAccessResource na API Go.
    function canViewStudentData(studentId) {
      return canUseBusinessResources() && (
        request.auth != null && (
          request.auth.uid == studentId ||
          isAdmin()
        )
      );
    }
    // Allowlist estrita dos campos que o DONO pode alterar no próprio perfil
    // via SDK de cliente. Derivada dos fluxos reais (GET/PUT /api/me: name,
    // email, photoURL, bio). Qualquer outro campo — incluindo createdAt e
    // authProvider (controles internos de escrita) — só muda pela API Go
    // (Admin SDK, que ignora estas regras). affectedKeys().hasOnly() bloqueia
    // o update INTEIRO se QUALQUER outra chave for tocada: uma requisição
    // "name + role", "name + status" etc. é negada como um todo, e mesmo
    // campos não administrativos fora da lista (ex.: startDate) são negados
    // até que um fluxo real justifique incluí-los aqui.
    function allowedSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'email',
        'photoURL',
        'bio'
      ]);
    }

    // Permite apenas a criação do PERFIL PRÓPRIO ainda pendente de aprovação
    // SEM nenhum campo administrativo. O backend Go (Admin SDK) é quem cria
    // perfis com campos administrativos - o cliente nunca precisa de campos
    // privilegiados, então auto-declarar-se admin/ativo/rejeitado é negado.
    function isPendingSelfProfile() {
      let keys = request.resource.data.keys();
      return request.resource.data.status == 'pending_approval' &&
             !keys.hasAny(['role', 'planID', 'features',
                           'approvedBy', 'approvedAt', 'rejectedReason']);
    }

    // ── Perfis de usuário ──
    // Dono lê/atualiza o próprio perfil (somente campos da allowlist
    // allowedSelfProfileUpdate) e cria o próprio perfil pendente. Admin lê
    // qualquer perfil. Escrita que não seja a do próprio pendente/campos da
    // allowlist = via API Go.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isPendingSelfProfile();
      allow update: if isOwner(uid) && allowedSelfProfileUpdate();
      allow delete: if false;
    }

    // ── Feed ──
    // Leitura: aprovados (feed é recurso de comunidade; pendente/bloqueado
    // não acessa). Escrita: SOMENTE pela API Go (transações corrigem race).
    match /posts/{postId} {
      allow read: if canUseBusinessResources();
      allow create, update, delete: if false;
    }

    // ── Log diário de dieta ──
    // Leitura: próprio aluno + admin (aprovados).
    // Escrita: só API Go (transações preservam createdAt).
    match /dietLogs/{docId} {
      allow read: if canViewStudentData(resource.data.studentId);
      allow write: if false;
    }

    // ── Coleções gerenciadas apenas pela API Go (Admin SDK) ──
    match /workouts/{document=**} {
      allow read, write: if false;
    }
    // Programas de treinamento (F19): igual a treinos, o programa é lido e
    // escrito exclusivamente pela API Go (o SDK de cliente não acessa nem
    // para leitura — a listagem de programas do aluno passa pela API).
    match /programs/{document=**} {
      allow read, write: if false;
    }
    match /diets/{document=**} {
      allow read, write: if false;
    }
    match /workoutHistory/{document=**} {
      allow read, write: if false;
    }

    // ── Planos ──
    // Leitura: aprovados. Escrita: só API Go (create/update/delete via admin
    // pelo SDK de cliente é negado - contornaria a API).
    match /plans/{planId} {
      allow read: if canUseBusinessResources();
      allow write: if false;
    }

    // ── Biblioteca de exercícios (catálogo global — F5) ──
    // Leitura: aprovados (aluno consulta, mas nunca escreve). Escrita: somente
    // pela API Go — create/update/delete via SDK de cliente é negado para TODOS
    // (aluno e admin), preservando "escrita de negócio só via API".
    match /exercises/{exerciseId} {
      allow read: if canUseBusinessResources();
      allow write: if false;
    }

    // ── Ranking ──
    // Nota corrente: leitura para aprovados; escrita só da API.
    match /scores/{uid} {
      allow read: if canUseBusinessResources();
      allow write: if false;
    }

    // Histórico de ciclos (scores_history/{uid}/cycles/{cycleId}):
    // próprio aluno e admin leem (aprovados).
    match /scores_history/{uid}/{document=**} {
      allow read: if canViewStudentData(uid);
      allow write: if false;
    }
  }
}